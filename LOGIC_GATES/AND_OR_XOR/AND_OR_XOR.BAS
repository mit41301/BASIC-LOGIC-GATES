10     REM AND, OR & XOR GATE BASIC-52
20     REM
100    PRINT "AND GATE"
105    PRINT " A","  B","  Y"
110    FOR I=0 TO 1
120    FOR J=0 TO 1
130   K=I.AND.J
140    PRINT I,J,K
150    NEXT J
160    NEXT I
170    PRINT : REM STOP
180    PRINT " OR GATE"
205    PRINT " A","  B","  Y"
210    FOR I=0 TO 1
220    FOR J=0 TO 1
230   K=I.OR.J
240    PRINT I,J,K
250    NEXT J
260    NEXT I
265    PRINT : REM STOP
270    PRINT "XOR GATE"
305    PRINT " A","  B","  Y"
310    FOR I=0 TO 1
320    FOR J=0 TO 1
330   K=I.XOR.J
340    PRINT I,J,K
350    NEXT J
360    NEXT I
370    END

